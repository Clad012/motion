# Copy to .env.local (gitignored) and fill in. Only needed to generate new assets;
# rendering the committed videos needs no key.

# ElevenLabs: voiceovers (pnpm voiceover) and sound effects (pnpm sfx).
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Google Gemini: generated images (pnpm images).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
